{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "ConfigReader Config Manager",
    "version": "0.1.0",
    "identifier": "com.configreader.config-manager",
    "bundle": {
        "active": true,
        "icon": [
            "icons/icon.ico",
            "icons/logo-sigmasquare.png"
        ],
        "resources": [
            "../sample-workspace/config"
        ]
    },
    "build": {
        "beforeDevCommand": "npm --prefix frontend run dev",
        "beforeBuildCommand": "npm --prefix frontend run build",
        "devUrl": "http://localhost:5174",
        "frontendDist": "../frontend/dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Config Manager",
                "width": 1200,
                "height": 800
            }
        ],
        "security": {
            "csp": null
        }
    }
}